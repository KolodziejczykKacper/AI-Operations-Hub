# Copy to .env (ignored by Git). Contains NO secrets in Stage 1.
AIOPS_MAX_EML_BYTES=5242880
AIOPS_MAX_TEXT_CHARS=200000
AIOPS_MAX_MIME_PARTS=50
AIOPS_MAX_HEADERS=300
AIOPS_DATABASE_URL=sqlite:///data/local/ai_ops_hub.db
AIOPS_SQLITE_BUSY_TIMEOUT_MS=5000

# --- Optional Claude API analysis (Stage 7). OFF by default; real requests cost money. ---
# AIOPS_CLAUDE_ENABLED=true
# AIOPS_CLAUDE_MODEL=claude-haiku-5-5
# AIOPS_CLAUDE_MAX_OUTPUT_TOKENS=4000
# AIOPS_CLAUDE_MAX_INPUT_CHARS=20000
# AIOPS_CLAUDE_MAX_COST_USD_PER_REQUEST=0.02
# AIOPS_CLAUDE_DAILY_BUDGET_USD=0.25
# Put the key ONLY in your local .env (ignored by Git) or in the environment, never in code:
# ANTHROPIC_API_KEY=
